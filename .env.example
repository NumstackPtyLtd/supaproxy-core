# SupaProxy environment variables.
# Copy to .env and fill in required values.
#
# Required — server will not start without these.
# AI keys and Slack tokens are configured at runtime via Settings.
#
# Generate secrets:
#   JWT_SECRET:  openssl rand -hex 32
#   DB_PASSWORD: openssl rand -hex 16

# Auth
JWT_SECRET=

# Server
PORT=3001
CORS_ORIGINS=http://localhost:4322,http://localhost:3001
DASHBOARD_URL=http://localhost:4322

# Database (Docker mapped to host port 3308)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3308
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=supaproxy

# Queue (Docker mapped to host port 6380)
QUEUE_HOST=127.0.0.1
QUEUE_PORT=6380

# Session store (Docker mapped to host port 6380)
SESSION_HOST=127.0.0.1
SESSION_PORT=6380

# Audit logs
SUPAPROXY_LOG_DIR=./var/logs

# Optional: vector store path (defaults to ./data/vectors)
VECTOR_STORE_PATH=./data/vectors
